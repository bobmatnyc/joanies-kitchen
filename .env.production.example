# =============================================================================
# PRODUCTION ENVIRONMENT VARIABLES - VERCEL DEPLOYMENT
# =============================================================================
# This file contains all environment variables needed for Vercel production deployment
# For complete setup instructions, see: docs/VERCEL_DEPLOYMENT.md
#
# SECURITY WARNING:
# - NEVER commit actual API keys to git
# - Use Vercel Dashboard to set these variables securely
# - This file is for documentation purposes only
# =============================================================================

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================

# Public URL for production deployment
# Production domain: https://joanies.kitchen (www redirects to apex)
NEXT_PUBLIC_APP_URL=https://joanies.kitchen

# Node.js environment (auto-managed by Vercel - DO NOT SET MANUALLY)
# NODE_ENV=production

# =============================================================================
# DATABASE CONFIGURATION (NEON POSTGRESQL)
# =============================================================================

# Primary database connection (pooled) - REQUIRED
# Get from: Neon Console -> Connection Details -> Pooled Connection
# Format: postgresql://user:password@host/database?sslmode=require
DATABASE_URL=postgresql://user:password@host.neon.tech/database?sslmode=require

# Direct database connection (unpooled) - OPTIONAL
# Get from: Neon Console -> Connection Details -> Direct Connection
# Used for migrations and administrative tasks
DATABASE_URL_UNPOOLED=postgresql://user:password@host.neon.tech/database?sslmode=require

# =============================================================================
# AUTHENTICATION — Auth.js (NextAuth v5), Google only (#22)
# =============================================================================
# See docs/guides/authentication.md.

# Session JWT signing secret - REQUIRED. Rotating it signs everyone out.
# Generate: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-random-32-byte-secret

# Google OAuth web client - REQUIRED
# Redirect URI: https://joanies.kitchen/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Admin emails (#22): comma-separated; compared trimmed and case-insensitively.
# A listed, Google-verified email may sign in without a seeded row and gets
# users.is_admin = true at sign-in. Unset or empty grants no admin.
# Real values live only in .env.local / Vercel — never commit them.
AUTH_ADMIN_EMAILS=admin@example.com

# Canonical auth URL - Production scope only
AUTH_URL=https://joanies.kitchen

# =============================================================================
# AI/ML SERVICES
# =============================================================================

# OpenRouter API key - REQUIRED
# Get from: https://openrouter.ai/ -> API Keys
# Used for: AI recipe generation, ingredient substitutions, search enhancement
# Format: sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENROUTER_API_KEY=sk-or-v1-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# Brave Search API key - REQUIRED
# Get from: https://brave.com/search/api/ -> API Keys
# Used for: Web recipe search, recipe discovery, ingredient information
# Production value: BSA2IWyjQXpnW3qLL7rykFt8VxOzc8T
BRAVE_SEARCH_API_KEY=BSA2IWyjQXpnW3qLL7rykFt8VxOzc8T

# Hugging Face API key - REQUIRED
# Get from: https://huggingface.co/ -> Settings -> Access Tokens
# Used for: Text embeddings, semantic search, vector similarity (pgvector)
# Format: hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
# Permissions needed: Read access
HUGGINGFACE_API_KEY=hf_XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX

# =============================================================================
# CRON JOB CONFIGURATION
# =============================================================================

# Secret token required to authorize the /api/cron/daily-recipe endpoint.
# Set in Vercel Dashboard → Settings → Environment Variables (Production scope).
# Generate with: openssl rand -hex 32
# Also configure in Vercel Cron settings as the Authorization header value.
CRON_SECRET=your-cron-secret-here

# Max recipes to store per daily cron run (default: 5 if unset).
# Raise to ingest more recipes per day without a code deploy.
CRON_MAX_RECIPES=5

# Optional fixed search query override for daily discovery cron.
# When set, replaces the built-in rotating zero-waste query set.
# Leave unset to use the default rotating queries.
CRON_SEARCH_QUERY=

# =============================================================================
# VERCEL AUTO-GENERATED VARIABLES (DO NOT SET MANUALLY)
# =============================================================================
# These are automatically provided by Vercel - DO NOT configure manually

# Vercel deployment URL (auto-generated)
# VERCEL_URL=your-app.vercel.app

# Vercel environment (auto-generated: production, preview, or development)
# VERCEL_ENV=production

# Vercel project ID (auto-generated)
# VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxx

# Vercel Git commit SHA (auto-generated)
# VERCEL_GIT_COMMIT_SHA=abc123...

# Vercel Git commit ref (auto-generated)
# VERCEL_GIT_COMMIT_REF=main

# =============================================================================
# ENVIRONMENT VARIABLE SCOPES FOR VERCEL
# =============================================================================
#
# When adding variables in Vercel Dashboard (Settings -> Environment Variables),
# select the appropriate scopes:
#
# PRODUCTION SCOPE:
# - DATABASE_URL (production database)
# - AUTH_SECRET, AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET, AUTH_ADMIN_EMAILS
# - AUTH_URL (https://joanies.kitchen)
# - OPENROUTER_API_KEY
# - BRAVE_SEARCH_API_KEY
# - HUGGINGFACE_API_KEY
# - NEXT_PUBLIC_APP_URL (production domain)
#
# PREVIEW SCOPE (Google sign-in does not work on preview URLs; see docs):
# - DATABASE_URL (can use same or separate preview database)
# - OPENROUTER_API_KEY (same as production)
# - BRAVE_SEARCH_API_KEY (same as production)
# - HUGGINGFACE_API_KEY (same as production)
# - NEXT_PUBLIC_APP_URL (leave empty for auto-generated preview URLs)
#
# DEVELOPMENT SCOPE:
# - DATABASE_URL (local or dev database)
# - AUTH_SECRET, AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET
# - OPENROUTER_API_KEY (same as production)
# - BRAVE_SEARCH_API_KEY (same as production)
# - HUGGINGFACE_API_KEY (same as production)
# - NEXT_PUBLIC_APP_URL (http://localhost:3004)
#
# =============================================================================

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# FOR VERCEL DEPLOYMENT:
# ----------------------
# 1. DO NOT copy this file to .env.local or .env.production
# 2. Add all variables directly in Vercel Dashboard:
#    https://vercel.com/dashboard -> Your Project -> Settings -> Environment Variables
# 3. Select appropriate scopes for each variable (Production, Preview, Development)
# 4. Use production keys (pk_live_, sk_live_) for Production environment
# 5. Use test keys (pk_test_, sk_test_) for Preview/Development environments
# 6. After adding all variables, trigger a new deployment
#
# FOR LOCAL DEVELOPMENT:
# ----------------------
# 1. Copy .env.example to .env.local
# 2. Fill in your local/development values
# 3. Use test/development API keys (pk_test_, sk_test_)
# 4. Never commit .env.local to git
#
# DETAILED DOCUMENTATION:
# -----------------------
# See: docs/VERCEL_DEPLOYMENT.md for complete setup guide
#
# =============================================================================

# =============================================================================
# API KEY ACQUISITION CHECKLIST
# =============================================================================
#
# [ ] Neon Database: https://console.neon.tech
#     - Create project
#     - Get pooled and direct connection strings
#     - Enable pgvector extension
#
# [ ] Google OAuth client: https://console.cloud.google.com/apis/credentials
#     - Create an OAuth client ID of type "Web application"
#     - Origins: https://joanies.kitchen, http://localhost:3002
#     - Redirect URIs: https://joanies.kitchen/api/auth/callback/google,
#       http://localhost:3002/api/auth/callback/google
#     - Set the consent screen to "In production"
#
# [ ] OpenRouter API: https://openrouter.ai
#     - Create account
#     - Generate API key
#     - Add credits to account
#
# [ ] Brave Search API: https://brave.com/search/api
#     - Sign up for API access
#     - Obtain API key: BSA2IWyjQXpnW3qLL7rykFt8VxOzc8T
#
# [ ] Hugging Face: https://huggingface.co
#     - Create account
#     - Generate access token (Read permissions)
#     - Verify model access (sentence-transformers)
#
# =============================================================================

# =============================================================================
# SECURITY BEST PRACTICES
# =============================================================================
#
# 1. Key Rotation:
#    - Rotate API keys quarterly
#    - Update in Vercel immediately after rotation
#    - Test thoroughly after updates
#
# 2. Key Separation:
#    - Use different keys for production vs preview/dev
#    - Never use production keys in development
#    - Never use test keys in production
#
# 3. Access Control:
#    - Limit Vercel project access to necessary team members
#    - Use Vercel Teams for enterprise deployments
#    - Enable 2FA on all service accounts
#
# 4. Monitoring:
#    - Set up billing alerts for all paid APIs
#    - Monitor API usage dashboards
#    - Set rate limits where available
#
# 5. Secret Management:
#    - Never commit secrets to git
#    - Use .gitignore for .env files
#    - Review git history before pushing
#
# =============================================================================

# =============================================================================
# REQUIRED FEATURES AND THEIR DEPENDENCIES
# =============================================================================
#
# Feature                     | Required Variables
# --------------------------- | --------------------------------------------------
# User Authentication         | AUTH_SECRET, AUTH_GOOGLE_ID, AUTH_GOOGLE_SECRET, DATABASE_URL
# Recipe Storage              | DATABASE_URL
# AI Recipe Generation        | OPENROUTER_API_KEY
# Web Recipe Search           | BRAVE_SEARCH_API_KEY
# Semantic Search             | HUGGINGFACE_API_KEY, DATABASE_URL (with pgvector)
# Recipe Recommendations      | HUGGINGFACE_API_KEY, DATABASE_URL (with pgvector)
# User Profiles               | AUTH_SECRET, DATABASE_URL
# Meal Planning               | DATABASE_URL
# Shopping Lists              | DATABASE_URL
#
# =============================================================================
