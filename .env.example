# =============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# =============================================================================
# Copy this file to .env.local and fill in your actual values
# NEVER commit .env.local to git - it contains sensitive information

# =============================================================================
# APPLICATION CONFIGURATION
# =============================================================================
# Base URL for your application
# Development: http://localhost:3004 (or your custom port)
# Production: https://your-domain.com
NEXT_PUBLIC_APP_URL=http://localhost:3004

# Public support address shown on /privacy and /terms (code default: support@1mc.io)
NEXT_PUBLIC_SUPPORT_EMAIL=support@1mc.io

# Node.js environment
# Values: development, production, test
NODE_ENV=development

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL connection string (required)
# For Neon DB: postgresql://user:password@host:port/database?sslmode=require
# For local PostgreSQL: postgresql://user:password@localhost:5432/database
DATABASE_URL=postgresql://user:password@host:port/database?sslmode=require

# Unpooled database URL (optional - used for migrations and direct connections)
# Only needed if using connection pooling services like Neon
DATABASE_URL_UNPOOLED=postgresql://user:password@host:port/database?sslmode=require

# =============================================================================
# AUTHENTICATION — Auth.js (NextAuth v5), Google only (#22)
# =============================================================================
# See docs/guides/authentication.md. With these unset the app runs signed-out.
# Registration is closed: only emails pre-seeded with `pnpm auth:seed-user`
# can sign in.

# Random secret that signs session JWTs. Rotating it signs everyone out.
# Generate: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-random-32-byte-secret

# Google OAuth web client credentials
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Admin emails (#22): comma-separated; compared trimmed and case-insensitively.
# A listed, Google-verified email may sign in without a seeded row and gets
# users.is_admin = true at sign-in. Unset or empty grants no admin.
# Real values live only in .env.local / Vercel — never commit them.
AUTH_ADMIN_EMAILS=admin@example.com

# Canonical URL. Set in Vercel Production only (https://joanies.kitchen).
# AUTH_URL=http://localhost:3002

# =============================================================================
# AI FEATURES (OPENROUTER)
# =============================================================================
# OpenRouter API key for AI-powered recipe features
# Get your API key from https://openrouter.ai/
# Required for: recipe generation, search suggestions, ingredient substitutions
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# WEB SEARCH & SCRAPING
# =============================================================================
# Tavily API key for AI-powered recipe URL discovery
# Get your API key from https://tavily.com/
# Used for: discovering recipe URLs from the web with AI-powered search
TAVILY_API_KEY=tvly-prod-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Firecrawl API key for web scraping
# Get your API key from https://firecrawl.dev/
# Used for: scraping recipe content from discovered URLs
FIRECRAWL_API_KEY=fc-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# SerpAPI key for Google Search API
# Get your API key from https://serpapi.com/
# Used for: alternative recipe URL discovery via Google Search
SERPAPI_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Jina.ai API key — used for Reader (web content extraction), Embeddings v3
# (semantic search vectors), and Reranker v2 (similar-recipe reordering).
# Get your API key from https://jina.ai/
JINA_API_KEY=jina_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic API key for Claude-powered recipe structuring and chef bio generation
# Get your API key from https://console.anthropic.com/
# Used for: structuring raw content into recipe schema (Claude Haiku), chef bio summarisation
# Optional but recommended — improves extraction quality for non-schema.org pages
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# =============================================================================
# HUGGING FACE AI MODELS
# =============================================================================
# Hugging Face API key for AI model access
# Get your API key from https://huggingface.co/settings/tokens
# Used for: accessing pre-trained models for recipe classification, ingredient extraction
HUGGINGFACE_API_KEY=hf_your_api_key_here

# =============================================================================
# FILE STORAGE (VERCEL BLOB)
# =============================================================================
# Vercel Blob Storage for recipe images
# Get your token from Vercel Dashboard -> Storage -> Blob
# Required for: recipe image uploads, user-submitted photos
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_XXXXXXXXXXXXXXXXXXXX

# =============================================================================
# VERCEL DEPLOYMENT (AUTO-GENERATED)
# =============================================================================
# The following variables are automatically set by Vercel
# DO NOT manually set these in production - Vercel manages them

# Vercel deployment URL (auto-generated)
# VERCEL_URL=your-app-vercel.app

# Vercel environment (auto-generated)
# VERCEL_ENV=production

# Vercel project ID (auto-generated)
# VERCEL_PROJECT_ID=prj_xxxxxxxxxxxxxxxxxxxx

# =============================================================================
# AUTOMATION / INTEGRATION TESTING
# =============================================================================
# Bypass session auth on all v1 API routes for CI and integration tests.
# Set to a long random secret (e.g. openssl rand -hex 32).
# Pass as: Authorization: Bearer <secret>
# Works in any environment when this variable is set.
# Leave empty (or unset) to disable the bypass.
AUTOMATION_BYPASS_SECRET=

# =============================================================================
# CRON JOB CONFIGURATION
# =============================================================================
# Secret token required to trigger the daily recipe cron endpoint.
# Set to a long random string (e.g. openssl rand -hex 32).
# Pass as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# Max recipes to store per daily cron run (default: 5).
# Increase to ingest more recipes per day without a code deploy.
CRON_MAX_RECIPES=5

# Optional fixed search query for the daily discovery cron.
# When set, overrides the default rotating zero-waste query set.
# Leave empty (or unset) to use the built-in rotating queries.
CRON_SEARCH_QUERY=

# =============================================================================
# SETUP INSTRUCTIONS
# =============================================================================
#
# 1. REQUIRED SETUP:
#    - Set DATABASE_URL (PostgreSQL connection string)
#    - Set OPENROUTER_API_KEY (for AI features)
#    - Set NEXT_PUBLIC_APP_URL (your app's URL; production is https://joanies.kitchen)
#    - Set BLOB_READ_WRITE_TOKEN (for image uploads)
#
# 2. OPTIONAL AUTHENTICATION (Google sign-in):
#    - Set AUTH_SECRET, AUTH_GOOGLE_ID and AUTH_GOOGLE_SECRET
#    - Authentication can be disabled - the app runs signed-out without it
#    - Google OAuth redirect URIs:
#      http://localhost:3002/api/auth/callback/google
#      https://joanies.kitchen/api/auth/callback/google
#
# 4. DATABASE SETUP:
#    - Run: npm run db:generate (generate migrations)
#    - Run: npm run db:migrate (apply migrations)
#    - Run: npm run db:seed:system (populate with example recipes)
#
# =============================================================================
